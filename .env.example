# Any OpenAI-compatible endpoint. Can also be set in the Settings page, which encrypts the key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

# Optional. Without it a key file is generated at data/.secret.key
# ATLAS_SECRET_KEY=
# ATLAS_DATA_DIR=./data
# A run stops with a clear error once it has used this many tokens.
# Admin sign-in. Required: the app refuses all sign-ins without these
ATLAS_ADMIN_USERNAME=
ATLAS_ADMIN_PASSWORD=
# Hours before a session ends
# ATLAS_SESSION_HOURS=12
# ATLAS_RUN_TOKEN_LIMIT=600000
# Seconds before one model call fails. It is retried once
# ATLAS_MODEL_TIMEOUT=180
# ATLAS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ATLAS_ALLOWED_HOSTS=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
