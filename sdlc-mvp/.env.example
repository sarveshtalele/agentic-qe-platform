# Optional external or local OpenAI-compatible chat-completions endpoint.
# For Ollama, depending on your version/configuration, a compatible URL may be http://127.0.0.1:11434/v1
SDLC_LLM_BASE_URL=
SDLC_LLM_MODEL=
SDLC_LLM_API_KEY=

# Local storage paths. Change WORKSPACE_ROOT only to a directory you trust.
SDLC_DATA_DIR=./data
SDLC_WORKSPACE_ROOT=./workspaces
SDLC_MAX_UPLOAD_MB=15
SDLC_MAX_ARCHIVE_MB=200
SDLC_COMMAND_TIMEOUT_SECONDS=180

# Repository commands are disabled by default. They are NOT sandboxed.
# Enable only for repositories you trust and preferably in an isolated OS/container environment.
SDLC_ENABLE_REPO_COMMANDS=false
SDLC_HOST=127.0.0.1
SDLC_PORT=8000

# Optional token status only; a full GitHub OAuth picker is not implemented in this MVP.
GITHUB_TOKEN=
