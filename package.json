{
  "name": "agentic-qe-platform",
  "version": "1.0.0",
  "description": "Enterprise Multi-Agent Quality Engineering & Autonomous SDLC Platform (MAF + Agentic-QE)",
  "private": true,
  "scripts": {
    "dev:frontend": "cd src/frontend && npm run dev",
    "build:frontend": "cd src/frontend && npm run build",
    "start:frontend": "cd src/frontend && npm start",
    "dev:backend": ".venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000 --reload",
    "start:backend": ".venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "test": ".venv/bin/pytest tests/ -v",
    "test:unit": ".venv/bin/pytest tests/test_maf_unit.py tests/test_maf_governance.py tests/test_maf_evaluation.py -v",
    "test:e2e": ".venv/bin/pytest tests/test_nextjs_e2e_playwright.py tests/test_e2e_playwright.py -v"
  },
  "keywords": [
    "agentic-qe",
    "microsoft-agent-framework",
    "quality-engineering",
    "autonomous-sdlc",
    "gherkin",
    "playwright"
  ],
  "author": "Sarvesh Talele",
  "license": "Apache-2.0"
}
